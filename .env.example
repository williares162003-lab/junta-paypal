# PayPal SANDBOX credentials (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Sandbox test accounts (Testing Tools -> Sandbox Accounts). Emails only, never passwords.
ORGANIZER_EMAIL=
MEMBER_EMAILS=member1@example.com,member2@example.com,member3@example.com,member4@example.com

# AI model: any OpenAI-compatible API. Default: Groq free tier (console.groq.com)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
AI_API_KEY=

# Web app
ORGANIZER_PIN=
FLASK_SECRET_KEY=
